{
  "name": "Nexo Web",
  "short_name": "Nexo",
  "description": "PWA para consultar una fuente M3U propia y abrir o copiar enlaces AceStream. No incluye listas ni enlaces.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#070b10",
  "theme_color": "#070b10",
  "categories": ["utilities"],
  "icons": [
